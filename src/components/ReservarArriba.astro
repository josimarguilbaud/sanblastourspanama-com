---
/**
 * La reserva, a la vista en el móvil (20/11/2026).
 *
 * En escritorio el formulario va en la barra lateral pegajosa, al lado del
 * texto. En el móvil esa barra cae DEBAJO del artículo: medido en
 * /tours/classic-day-tour, el botón de reservar quedaba a 4.351 px, unas cinco
 * pantallas, y arriba no había ni una prueba de que otros ya habían ido.
 *
 * Esto pone, solo por debajo de `lg`, la nota (4,9 sobre las valoraciones de
 * Google y TripAdvisor, la misma que declara el schema; +5.500 viajeros, cifra
 * del dueño) y un botón que baja hasta `#reservar`, el formulario de verdad.
 * El artículo no se mueve: esta web vive del texto que posiciona.
 *
 * Una sola estrella con la cifra, no cinco: de cada reseña suelta no consta la
 * puntuación (ver Reviews.astro), y cinco estrellas aquí lo sugerirían.
 */
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: string;
  /** Precio por adulto (o por noche) desde src/lib/precios.ts; sin él no se pinta. */
  precio?: number;
}

const { lang, precio } = Astro.props;
const t = useTranslations(lang);
---
<div class="mt-5 lg:hidden">
  <p class="text-sm font-semibold text-deep">
    <span class="text-amber" aria-hidden="true">★</span> {t('reservar.prueba')}
  </p>
  <a
    href="#reservar"
    class="mt-3 flex w-full items-center justify-center gap-2 rounded-xl bg-coral px-5 py-3.5 text-base font-semibold text-white no-underline shadow-lg shadow-coral/25 hover:bg-coraldark"
    data-gtm="pana_reservar_arriba"
  >
    {t('reservar.saltar')}
    {precio != null && <span class="font-normal text-white/90">· {t('reservar.desde')} ${precio}</span>}
  </a>
</div>
