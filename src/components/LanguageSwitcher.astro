---
/*
 * El selector de idioma conserva la PÁGINA; ya no manda a la portada.
 *
 * Enlazaba siempre a la portada de cada idioma, y su comentario decía que era
 * porque no todo estaba traducido y un enlace a la misma página podía dar 404.
 * Eso dejó de ser cierto: las cinco colecciones existen en los cinco idiomas
 * con el MISMO slug (medido el 02/09/2026, 0 ficheros ausentes), y para las
 * pocas páginas cuyo slug sí cambia —las legales— está `rutas-por-idioma`, que
 * se escribió al arreglar el hreflang.
 *
 * Mandar a la portada tira la visita: quien llegó buscando una isla concreta y
 * cambia de idioma aparece en la home de otro idioma, y se va.
 *
 * `availableLocales` ya lo calcula el layout para el hreflang, así que aquí se
 * reutiliza y solo se ofrecen los idiomas en los que ESTA página existe. Sin
 * ruta se cae a la portada, que es el comportamiento de antes.
 */
import { locales, languageNames, localizedPath, defaultLocale } from '../i18n/ui';
import { rutaSinPrefijo } from '../i18n/rutas-por-idioma';

interface Props {
  /** Ruta canónica SIN prefijo de idioma, la misma que recibe `Seo`. */
  path?: string;
  /** Idiomas en los que existe esta página. Sin lista, se ofrecen todos. */
  availableLocales?: string[];
}
const { path, availableLocales } = Astro.props;

const currentLocale = Astro.currentLocale ?? defaultLocale;
const ofrecidos = locales.filter((l) => !availableLocales || availableLocales.includes(l));
const destino = (locale: string) =>
  path ? localizedPath(locale, rutaSinPrefijo(path, locale)) : localizedPath(locale, '/');
---

<div class="group relative" data-dropdown>
  <button
    type="button"
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="language-menu"
    class="flex items-center gap-1 rounded-full border border-deep/15 px-3 py-1.5 text-sm font-medium text-deep/70 hover:border-teal hover:text-teal focus:outline-none focus-visible:border-teal"
  >
    {languageNames[currentLocale as keyof typeof languageNames] ?? currentLocale}
    <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
  </button>
  <div id="language-menu" class="invisible absolute right-0 top-full z-50 w-40 pt-2 opacity-0 transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
    <div class="rounded-xl bg-white py-2 shadow-lg ring-1 ring-deep/10">
      {ofrecidos.map((locale) => (
        <a
          href={destino(locale)}
          hreflang={locale}
          class:list={[
            'block px-4 py-1.5 text-sm hover:bg-sand',
            locale === currentLocale ? 'font-bold text-teal' : 'text-deep/80',
          ]}
        >
          {languageNames[locale]}
        </a>
      ))}
    </div>
  </div>
</div>
