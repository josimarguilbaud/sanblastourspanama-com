---
// Canonical + hreflang + OG/Twitter tags, centralized so every page gets the
// same correct SEO markup instead of hand-copied <meta> blocks per page.
import { defaultLocale, locales as allLocales } from '../i18n/ui';
import { idiomasDeRutaFija, rutaSinPrefijo } from '../i18n/rutas-por-idioma';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Path without locale prefix, e.g. "/islands/chichime". "/" for home. */
  path?: string;
  /**
   * Locales that actually have a translated version of THIS page. Defaults to
   * just the current locale — emitting hreflang for a locale with no real
   * translation would tell Google a page exists when it doesn't (404 risk).
   *
   * Collection pages (tours/islands/guides/blog/packages) derive this from the
   * content files via `i18n/content.ts`. FIXED pages must NOT pass it: for
   * those, `i18n/rutas-por-idioma.ts` is the single source of truth and takes
   * precedence — the hand-written lists that used to live in each page went
   * stale (`/tours` still claimed ['en','es'] long after the other three
   * locales existed, so three of its five versions were never announced).
   */
  availableLocales?: string[];
  /**
   * The error page. It gets NO hreflang: `/404` is not a published URL — nginx
   * serves it as the body of an error, so every alternate it announced pointed
   * at a page that does not exist, and an hreflang to a 404 is worse than no
   * hreflang at all.
   */
  errorPage?: boolean;
}

const { title, description, image, path = '/', availableLocales, errorPage } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://sanblastourspanama.com';

// The locale prefix alone does NOT give the URL: the legal pages have a
// translated slug (`/legal/terms` ↔ `/es/legal/terminos` ↔ `/de/legal/agb`),
// so the path itself has to be looked up per locale. Without that lookup every
// locale of a legal page pointed its canonical AND its hreflang at URLs that
// were never built. See i18n/rutas-por-idioma.ts.
function urlFor(locale: string) {
  const prefix = locale === defaultLocale ? '' : `/${locale}`;
  const localePath = rutaSinPrefijo(path, locale);
  const cleanPath = localePath === '/' ? '' : localePath;
  return `${siteUrl}${prefix}${cleanPath}` || siteUrl;
}

const currentLocale = Astro.currentLocale ?? defaultLocale;
const canonical = urlFor(currentLocale);
// Open Graph exige URL ABSOLUTA. Las fichas pasan la `heroImage` del
// frontmatter, que es una ruta de sitio (`/img/…`): WhatsApp, Facebook y X no
// la resuelven contra el origen, así que el enlace se compartía SIN miniatura
// en 325 de las 381 páginas. Solo el `og-default` de respaldo salía absoluto,
// que es justo por lo que pasó desapercibido. `siteUrl` ya viene sin barra
// final (ver arriba), así que basta con anteponerlo.
function urlAbsoluta(ruta: string) {
  if (/^https?:\/\//i.test(ruta)) return ruta;
  return `${siteUrl}${ruta.startsWith('/') ? '' : '/'}${ruta}`;
}

const ogImage = urlAbsoluta(image ?? '/og-default.webp');
const hreflangLocales = errorPage
  ? []
  : (idiomasDeRutaFija(path) ?? availableLocales ?? [currentLocale]).filter((l) =>
      (allLocales as readonly string[]).includes(l)
    );
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonical} />

{hreflangLocales.map((locale) => (
  <link rel="alternate" hreflang={locale} href={urlFor(locale)} />
))}
{hreflangLocales.includes(defaultLocale) && (
  <link rel="alternate" hreflang="x-default" href={urlFor(defaultLocale)} />
)}

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={currentLocale.replace('-', '_')} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
