---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  path?: string;
  availableLocales?: string[];
  /** Error page: no hreflang, see Seo.astro. */
  errorPage?: boolean;
  /** Extra JSON-LD for this page (object or array), emitted after the
   *  sitewide TravelAgency. Only pass markup whose content is VISIBLE on the
   *  page: Google penalises structured data that describes nothing on screen. */
  jsonld?: object | object[];
  /** Fuera del índice, con los enlaces seguidos. Es de las legales; ver Seo.astro. */
  noindex?: boolean;
  /**
   * Las reseñas que ESTA página muestra, para declararlas dentro del negocio.
   *
   * ⚠️ Solo se pasa desde una página que las pinta en pantalla. Google exige
   * que el marcado corresponda a contenido visible, y un `aggregateRating` sin
   * reseñas a la vista es incumplimiento directo: es el fallo que tiene hoy la
   * portada de sanblastourspty, que declara 4,9 sobre 2.000 con cero reseñas
   * en la misma entidad.
   *
   * Van DENTRO del `TravelAgency`, no como bloque suelto: un `Review` que no
   * dice qué reseña no sirve, y eso ya lo avisó Search Console el 02/09/2026.
   */
  reviews?: object[];
  /** El agregado real (Google + TripAdvisor). Solo junto a `reviews`. */
  aggregateRating?: object;
}

const { title, description, image, path, availableLocales, errorPage, jsonld, noindex, reviews, aggregateRating } = Astro.props;

// Sitewide business entity — same on every page so Google has one consistent
// TravelAgency record rather than only on the homepage.
//
// The address / geo / opening-hours triple came back from the static HTML this
// site replaced (subir-webs/sanblastourspanama/index.html in the chatbot-sanblas
// repo). The Astro port carried the name, url and phone across and dropped the
// rest, which is what tells Google this is a real business at a real place with
// real hours: the signals local results are built on. Same hole the sibling
// sanblasfull.com had, found on 2026-08-18 while fixing that one.
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  // ⚠️ Sin `@id` este negocio no se podía referenciar desde ningún otro dato
  // estructurado de la web: un `Review` o un `Product` que quisiera decir de
  // quién es no tenía a qué apuntar, y las dos webs hermanas sí lo tenían.
  // Es un identificador, no una URL que haya que servir: no se navega.
  '@id': 'https://sanblastourspanama.com/#organizacion',
  name: 'San Blas Tours Panamá',
  url: 'https://sanblastourspanama.com',
  image: 'https://sanblastourspanama.com/img/barco-hundido-snorkel-san-blas.webp',
  telephone: '+50764684720',
  email: 'info@sanblastravel.com',
  // El WhatsApp es el canal real de reserva, no un extra: `sameAs` lo declara
  // como perfil oficial del negocio y ata el numero al sitio.
  // Las otras dos webs del negocio, además del WhatsApp.
  //
  // Las hermanas ya se declaraban entre sí por esta misma vía, con este
  // razonamiento escrito en su código: el `sameAs` cruzado las reconcilia como
  // UN negocio ante el grafo de entidades, y es lo que evita que el reparto de
  // temas se lea como empresas distintas compitiendo. Esta web se quedó fuera
  // de aquel montaje. Sin esto, un buscador ve tres agencias que casualmente
  // comparten el mismo teléfono, que es la lectura peligrosa.
  sameAs: [
    'https://sanblasfull.com',
    'https://sanblastourspty.com',
    'https://wa.me/50764684720',
  ],
  // La senal internacional. El sitio esta en cinco idiomas y el dato
  // estructurado no lo decia en ninguna parte.
  availableLanguage: ['en', 'es', 'de', 'fr', 'pt-BR'],
  areaServed: 'Guna Yala, Panama',
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Ciudad de Panamá',
    addressLocality: 'Panamá',
    addressRegion: 'Panamá',
    postalCode: '0801',
    addressCountry: 'PA',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 8.9824, longitude: -79.5199 },
  // Tours leave at 5 AM and get back after dark, so the phone is answered
  // across that whole window, every day.
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '06:00',
    closes: '20:00',
  },
};

/* Las reseñas y su agregado entran DENTRO del negocio, y solo si la página que
 * las pasa las está pintando. Nunca uno sin el otro: un `aggregateRating` sin
 * reseñas visibles es incumplimiento, y unas reseñas sin agregado desaprovechan
 * un dato que el dueño confirmó como real. */
const negocio = reviews?.length
  ? { ...organizationJsonLd, review: reviews, ...(aggregateRating ? { aggregateRating } : {}) }
  : organizationJsonLd;

const ldItems = [negocio, ...(jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [])];
---

<!DOCTYPE html>
<html lang={Astro.currentLocale ?? 'en'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo title={title} description={description} image={image} path={path} availableLocales={availableLocales} errorPage={errorPage} noindex={noindex} />
    {ldItems.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0], j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-KKGVTL38');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=Fredoka:wght@500;600;700&family=Caveat:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-sand font-sans text-deep">
    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KKGVTL38" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-deep focus:px-5 focus:py-3 focus:text-sm focus:font-bold focus:text-white">
      Skip to content
    </a>
    <TopBar />
    <Header path={path} availableLocales={availableLocales} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
