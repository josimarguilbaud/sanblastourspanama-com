---
/**
 * Las veinte opiniones reales de viajeros.
 *
 * Hasta el 03/09/2026 esta web no tenía NINGUNA prueba social: ni una reseña,
 * ni agregado, ni una cita con nombre — siendo la de más tráfico orgánico de
 * las tres del negocio. Las veinte se mudaron desde las webs hermanas, no se
 * copiaron: el mismo texto en dos dominios del mismo dueño es duplicación.
 * Ver `src/lib/reviews.ts`.
 */
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Reviews from '../../components/Reviews.astro';
import BookingCta from '../../components/BookingCta.astro';
import { AGGREGATE, reviewsJsonLd } from '../../lib/reviews';

const LANG = "fr";
const SITIO = 'https://sanblastourspanama.com';

/* Las reseñas van dentro del TravelAgency, y el agregado con ellas: esta
 * página SÍ las muestra, que es lo que Google exige para aceptarlo. */
const resenas = reviewsJsonLd(LANG, SITIO);
const agregado = { '@type': 'AggregateRating', ...AGGREGATE };

const migas = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: "Accueil", item: `${SITIO}/fr` },
    { '@type': 'ListItem', position: 2, name: "Avis", item: `${SITIO}/fr/reviews` },
  ],
};
---

<Layout
  title="Avis sur San Blas — Ce que disent les voyageurs"
  description="Vingt avis de voyageurs déjà passés par San Blas : la culture guna, l’eau, les îles et ce qui les a surpris. Authentiques, sans retouche."
  path="/reviews"
  jsonld={migas}
  reviews={resenas}
  aggregateRating={agregado}
>
  <section class="bg-teal/5 py-14">
    <div class="mx-auto max-w-6xl px-4">
      <Breadcrumbs items={[{ label: "Accueil", href: "/fr" }, { label: "Avis" }]} />
      <h1 class="mt-4 text-3xl font-bold text-deep sm:text-4xl">Ce que disent les voyageurs qui y sont allés</h1>
      <p class="mt-4 max-w-3xl text-lg text-deep/75">Vingt avis de personnes qui ont déjà fait le voyage. Nous les publions tels qu’ils nous sont parvenus, sans étoiles : nous n’avons pas la trace de la note attribuée par chacun, et inventer ce chiffre serait la chose la plus facile de cette page et la plus malhonnête.</p>
    </div>
  </section>

  <Reviews lang={LANG} />

  <section class="bg-white py-14">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="text-2xl font-bold text-deep">Prêt à le voir par vous-même ?</h2>
      <p class="mt-2 text-deep/75">Choisissez une date et vérifiez les disponibilités, ou écrivez-nous sur WhatsApp si vous préférez en parler avant.</p>
      <div class="mt-5 flex flex-wrap items-center gap-4">
        <a href="/fr/tours" class="rounded-lg bg-coral px-6 py-3 font-semibold text-white no-underline hover:bg-coraldark">Voir les excursions</a>
        <BookingCta />
      </div>
    </div>
  </section>
</Layout>
