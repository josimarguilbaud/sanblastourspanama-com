---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import BookingCta from '../../../components/BookingCta.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import WidgetReserva from '../../../components/WidgetReserva.astro';
import { localesForSlug } from '../../../i18n/content';
import { useTranslations } from '../../../i18n/ui';
import { claveDeReserva } from '../../../lib/reservas';
import { faqJsonLd } from '../../../lib/faq';
import { TOURS_DIA, CABANAS } from '../../../lib/precios';

export async function getStaticPaths() {
  const allTours = await getCollection('tours');
  return allTours
    .filter((entry) => entry.id.startsWith('fr/'))
    .map((entry) => ({
      params: { slug: entry.id.replace(/^fr\//, '') },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name, category, tourKey, tagline, heroImage, duration, bestFor, seoTitle, seoDescription } = entry.data;
const slug = entry.id.replace(/^fr\//, '');
const t = useTranslations('fr');

const allTours = await getCollection('tours');
const availableLocales = localesForSlug(allTours, slug);
const claveReservable = claveDeReserva({ tourKey, category });

// `offers` sale SIEMPRE de src/lib/precios.ts, nunca escrito a mano — ver la
// cabecera de ese fichero. Si el tour/cabaña no está ahí (el Super VIP
// privado, que se cotiza por WhatsApp), no se emite `offers`: omitir es lo
// correcto, inventar un precio es justo el error que ese fichero previene.
const baseUrl = Astro.site?.toString().replace(/\/$/, '');
const pageUrl = `${baseUrl}/fr/tours/${slug}`;
let offers: { '@type': string; price: number; priceCurrency: string; availability: string; url: string } | undefined;
if (category === 'day-tour') {
  const precioEntry = TOURS_DIA.find((t) => t.tourKey === tourKey);
  if (precioEntry) {
    offers = { '@type': 'Offer', price: precioEntry.adulto, priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: pageUrl };
  }
} else if (category === 'overnight') {
  const precioEntry = CABANAS.find((c) => c.slug === slug);
  if (precioEntry) {
    offers = { '@type': 'Offer', price: precioEntry.porNoche, priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: pageUrl };
  }
}

// Este bloque TouristTrip no existía en de/fr/pt-br (solo en/es lo tenían) —
// se añade aquí igual que en las otras dos, con los mismos valores sin
// traducir (JSON-LD no es texto visible). Ver nota en el informe de esta fase.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name,
  description: seoDescription ?? tagline,
  image: heroImage,
  touristType: bestFor,
  provider: { '@type': 'TravelAgency', name: 'San Blas Tours Panamá' },
  ...(offers && { offers }),
};
// El FAQPage sale del propio Markdown: las preguntas se escriben en el cuerpo
// y por tanto se VEN en la pagina, que es lo que Google exige para marcarlas.
// Ver src/lib/faq.ts. Devuelve null si la entrada aun no tiene seccion.
const faqLd = faqJsonLd(entry.body ?? '');
---

<Layout
  title={seoTitle ?? `${name} — Excursions San Blas`}
  description={seoDescription ?? tagline}
  image={heroImage}
  path={`/tours/${slug}`}
  availableLocales={availableLocales}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}

  <div class="h-[45vh] min-h-[320px] w-full overflow-hidden">
    {/* El hero es la foto DE ESTA ficha. Antes las 105 paginas de tour y
        paquete servian todas la misma foto generica mientras el og:image si
        usaba la suya: el visitante veia una foto y al compartir salia otra.
        La generica queda solo de respaldo (heroImage es obligatoria en el
        esquema, asi que hoy no llega a usarse). */}
    <img src={heroImage ?? '/img/palmera-inclinada-playa-san-blas.webp'} alt={name} loading="eager" fetchpriority="high" class="h-full w-full object-cover" />
  </div>

  <Breadcrumbs items={[{ label: 'Accueil', href: '/' }, { label: 'Excursions', href: '/tours' }, { label: name }]} />

  <div class:list={["mx-auto max-w-6xl px-4 pb-12 pt-4 sm:px-6 lg:px-8", claveReservable && "lg:grid lg:grid-cols-[1fr_380px] lg:items-start lg:gap-10"]}>
    <article class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wide text-teal">
        {category === 'day-tour' ? "Excursion d'une Journée" : 'Nuitée'} · {duration}
      </p>
      <h1 class="mt-2 font-display text-4xl font-semibold text-deep sm:text-5xl">{name}</h1>
      <p class="mt-3 text-lg text-deep/70">{tagline}</p>

      <div class="mt-4 flex flex-wrap gap-2">
        {bestFor.map((tag: string) => (
          <span class="rounded-full bg-lime/10 px-3 py-1 text-sm font-medium text-limedark">
            {tag.replace(/-/g, ' ')}
          </span>
        ))}
      </div>

      <div class="prose prose-headings:font-heading prose-headings:text-deep prose-a:text-teal mt-8 max-w-none">
        <Content />
      </div>

      <div class="mt-12 rounded-3xl bg-deep p-8 text-center">
        <p class="font-heading text-xl font-bold text-white">Intéressé(e) par {name} ?</p>
        <BookingCta label={t('cta.book')} message={`Bonjour ! Je suis intéressé(e) par ${name}.`} class="mt-5 !bg-lime !shadow-lime/30 hover:!bg-limedark" />
      </div>
    </article>

    {claveReservable && (
      <aside class="mt-10 lg:sticky lg:top-28 lg:mt-0">
        <WidgetReserva
          tourKey={tourKey}
          category={category}
          lang="fr"
          titulo="Réserver cette excursion en ligne"
          nota={category === 'overnight' ? "Choisissez vos dates et payez l’acompte par carte. Le type de cabane se choisit dans le formulaire." : "Choisissez votre date, vérifiez les disponibilités et payez l’acompte par carte. Vous préférez en parler ? WhatsApp est juste en dessous."}
          compact
        />
      </aside>
    )}
  </div>
</Layout>
