---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import BookingCta from '../../../components/BookingCta.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import RelatedCards from '../../../components/RelatedCards.astro';
import EnlaceHermana from '../../../components/EnlaceHermana.astro';
import { localesForSlug } from '../../../i18n/content';
import { useTranslations } from '../../../i18n/ui';
import { faqJsonLd } from '../../../lib/faq';
import { Image } from 'astro:assets';
import { resolverImagen } from '../../../lib/images';

export async function getStaticPaths() {
  const allGuides = await getCollection('guides');
  return allGuides
    .filter((entry) => entry.id.startsWith('de/'))
    .map((entry) => ({
      params: { slug: entry.id.replace(/^de\//, '') },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, heroImage, relatedGuideSlugs, relatedIslandSlugs, seoTitle, seoDescription } = entry.data;
const slug = entry.id.replace(/^de\//, '');
const t = useTranslations('de');

const allGuides = await getCollection('guides');
const availableLocales = localesForSlug(allGuides, slug);

const relatedGuides = allGuides
  .filter((g) => g.id.startsWith('de/') && relatedGuideSlugs.includes(g.id.replace(/^de\//, '')))
  .map((g) => ({
    href: `/de/guides/${g.id.replace(/^de\//, '')}`,
    heroImage: g.data.heroImage ?? '/favicon.svg',
    title: g.data.title,
  }));

const allIslands = await getCollection('islands');
const relatedIslands = allIslands
  .filter((i) => i.id.startsWith('de/') && relatedIslandSlugs.includes(i.id.replace(/^de\//, '')))
  .map((i) => ({
    href: `/de/islands/${i.id.replace(/^de\//, '')}`,
    heroImage: i.data.heroImage,
    title: i.data.name,
  }));
// El FAQPage sale del propio Markdown: las preguntas se escriben en el cuerpo
// y por tanto se VEN en la pagina, que es lo que Google exige para marcarlas.
// Ver src/lib/faq.ts. Devuelve null si la entrada aun no tiene seccion.
const faqLd = faqJsonLd(entry.body ?? '');

// `Article` para todas las guías por igual: el esquema de `guides` no tiene
// fecha (ni `datePublished` ni `dateModified` — se omiten, no se inventan) ni
// una señal fiable de "esta guía es sobre un lugar" con la que distinguir
// `TouristAttraction` sin adivinar. `image` solo se añade si hay `heroImage`:
// varias guías no la tienen (mismo condicional que ya usa el hero de abajo).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: seoDescription ?? title,
  ...(heroImage && { image: heroImage }),
  publisher: { '@type': 'TravelAgency', name: 'San Blas Tours Panamá' },
};
---

<Layout
  title={seoTitle ?? `${title} — San-Blas-Inseln`}
  description={seoDescription ?? title}
  image={heroImage}
  path={`/guides/${slug}`}
  availableLocales={availableLocales}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}

  {heroImage && (
    <div class="h-[35vh] min-h-[260px] w-full overflow-hidden">
      <Image src={resolverImagen(heroImage)} densities={[1, 2]} alt={title} loading="eager" fetchpriority="high" class="h-full w-full object-cover" />
    </div>
  )}

  <Breadcrumbs items={[{ label: 'Startseite', href: '/' }, { label: 'Reiseführer', href: '/guides' }, { label: title }]} />

  <article class="mx-auto max-w-3xl px-4 pb-12 pt-4 sm:px-6 lg:px-8">
    <h1 class="font-display text-4xl font-semibold text-deep sm:text-5xl">{title}</h1>

    <div class="prose prose-headings:font-heading prose-headings:text-deep prose-a:text-teal mt-8 max-w-none">
      <Content />
      <EnlaceHermana tipo="guide" slug={slug} lang="de" />
    </div>

    <div class="mt-12 rounded-3xl bg-deep p-8 text-center">
      <p class="font-heading text-xl font-bold text-white">Bereit, Ihre Reise zu planen?</p>
      <p class="mt-2 text-sand/70">Schreiben Sie uns auf WhatsApp — eine echte Person hilft Ihnen.</p>
      <BookingCta label={t('cta.book')} class="mt-5 !bg-lime !shadow-lime/30 hover:!bg-limedark" />
    </div>
  </article>

  <RelatedCards title="Passende Inseln" items={relatedIslands} />
  <RelatedCards title="Verwandte Reiseführer" items={relatedGuides} />
</Layout>
