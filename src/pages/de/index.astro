---
/*
 * La portada alemana, portada de la inglesa el 03/09/2026.
 *
 * Tenia 89 lineas y 2 encabezados `<h2>` contra las 385 y 7 de la inglesa, y no
 * emitia `FAQPage`. El resto del sitio en aleman ya estaba a la par —islas,
 * tours, guias, paquetes, blog—: la portada era lo unico que se quedo de
 * muestra, y encima decia «Alle 11 San-Blas-Inseln» cuando son 12.
 *
 * Mismas secciones que la inglesa y la espanola, con el texto escrito a mano.
 * Nada de DeepL: en este proyecto tradujo «San Blas» como «São Blas» y el
 * «desde» de precio como «seit», y estuvo asi en produccion.
 */
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BookingCta from '../../components/BookingCta.astro';
import StatsCounters from '../../components/StatsCounters.astro';
import TourAmenityCard from '../../components/TourAmenityCard.astro';
import FaqTeaser from '../../components/FaqTeaser.astro';
import PhotoGalleryStrip from '../../components/PhotoGalleryStrip.astro';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('de');
const allIslands = await getCollection('islands');
const featured = allIslands.filter((entry) => entry.id.startsWith('de/')).slice(0, 5);

const allTours = await getCollection('tours');
const dayTours = allTours
  .filter((entry) => entry.id.startsWith('de/') && entry.data.category === 'day-tour')
  .slice(0, 3);

const allGuides = await getCollection('guides');
const guideSlugs = ['how-to-get-to-san-blas', 'what-to-pack', 'best-time-to-visit', 'guna-culture', 'snorkeling-diving', 'overnight-stays', 'health-safety-vaccinations', 'top-beaches'];
const infoGuides = guideSlugs
  .map((slug) => allGuides.find((g) => g.id === `de/${slug}.md`))
  .filter((g): g is NonNullable<typeof g> => Boolean(g));

// El numero de islas sale del catalogo, no de la memoria de nadie: esta portada
// llego a decir «Alle 11 San-Blas-Inseln» cuando son 12, y el titulo del indice
// prometia «Guide zu über 30 Inseln». Una cifra escrita a mano se desfasa sola.
const totalIslas = allIslands.filter((e) => e.id.startsWith('de/')).length;

const stats = [
  { value: '10+', label: 'Echte Touren und maßgeschneiderte Pakete' },
  { value: String(totalIslas), label: 'Inseln im Detail beschrieben' },
  { value: '5', label: 'Sprachen auf dieser Seite' },
  { value: '100%', label: 'Von der Guna-Gemeinde durchgeführt' },
];

const faqItems = [
  {
    q: 'Wie buche ich eine Tour konkret?',
    a: 'Schreib uns auf WhatsApp — nenne deine Daten und die Gruppengröße, und ein Mensch klärt Verfügbarkeit, Zahlung und Abholung direkt mit dir. Kein Kontaktformular, kein Warten auf eine E-Mail.',
  },
  {
    q: 'Was ist die Eintrittsgebühr von Guna Yala?',
    a: 'Guna Yala erhebt eine eigene Eintrittsgebühr: 22 Dollar für Ausländer und 7 für Ansässige, bar an der Kontrollstelle der Comarca. Sie steckt in keinem Tourpreis, weil sie nicht uns gehört, sondern der Gemeinde.',
  },
  {
    q: 'Brauche ich für Guna Yala einen Reisepass?',
    a: 'Ja. Guna Yala ist ein autonomes Gebiet mit eigener Kontrolle und registriert jeden, der einreist: Reisepass für Ausländer, Personalausweis für Ansässige. Digitale Kopien werden nicht akzeptiert.',
  },
  {
    q: 'Tagestour oder Übernachtung — was passt besser?',
    a: 'Beide beinhalten Inselhüpfen und Schnorcheln am Riff des gesunkenen Schiffs. Eine Übernachtung fügt den Sonnenuntergang hinzu, einen wirklich dunklen Nachthimmel und ein traditionelles Guna-Abendessen — dazu die Stunden, in denen keine Boote mehr kommen.',
  },
];

// Las cuatro preguntas de arriba se pintan en la pagina, y por eso se declaran.
// Marcar como FAQPage algo que el visitante no ve es justo lo que penaliza.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title="San-Blas-Touren ab Panama-Stadt — Tagestouren und Nächte"
  description="Die Inseln von San Blas im Detail erklärt, echte Guna-Kultur und Buchung per WhatsApp mit einem Menschen — kein Formular, kein Callcenter."
  path="/"
  jsonld={faqJsonLd}
>
  <section class="relative overflow-hidden bg-sand">
    <div class="mx-auto grid max-w-7xl items-center gap-8 px-4 py-14 sm:px-6 lg:grid-cols-2 lg:gap-4 lg:px-8 lg:py-20">
      <div class="relative z-10 text-center lg:text-left">
        <p class="font-script text-3xl text-teal">Es ist Zeit</p>
        <h1 class="mt-1 font-display text-4xl font-semibold leading-[1.1] text-deep sm:text-5xl lg:text-6xl">
          Das <span class="text-amber">Paradies</span> von Guna Yala zu entdecken
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-lg text-deep/70 lg:mx-0">
          Der ausführlichste deutschsprachige Guide zu den Inseln von San Blas — schreib uns auf
          WhatsApp und ein Mensch plant die Reise mit dir, ohne Kontaktformular.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-6 lg:justify-start">
          <BookingCta label={t('cta.book')} class="!bg-lime !shadow-lime/30 hover:!bg-limedark" />
          <a
            href="https://wa.me/50764684720"
            target="_blank"
            rel="noopener"
            class="flex items-center gap-2 text-left"
          >
            <svg class="h-8 w-8 text-teal" fill="currentColor" viewBox="0 0 24 24"><path d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.77.46 3.5 1.34 5.02L2 22l5.13-1.35A9.96 9.96 0 0012.04 22c5.52 0 10-4.48 10-10s-4.48-10-10-10zm0 18.15a8.1 8.1 0 01-4.14-1.13l-.3-.18-3.05.8.81-2.97-.2-.31a8.13 8.13 0 01-1.25-4.36c0-4.49 3.65-8.14 8.14-8.14 2.17 0 4.21.85 5.75 2.39a8.08 8.08 0 012.38 5.75c0 4.49-3.66 8.15-8.14 8.15z"/></svg>
            <span>
              <span class="block font-heading text-sm font-bold text-deep">Mehr erfahren</span>
              <span class="block font-script text-xl text-amber">Schreib uns</span>
            </span>
          </a>
        </div>
      </div>

      <div class="relative">
        <div
          class="h-72 overflow-hidden rounded-[2.5rem] sm:h-96 lg:h-[26rem]"
          style="clip-path: polygon(8% 0%, 100% 0%, 100% 92%, 92% 100%, 0% 100%, 0% 8%);"
        >
          <img
            src="/img/palmera-inclinada-playa-san-blas.webp"
            alt="San-Blas-Inseln, Panama"
            class="h-full w-full object-cover"
          />
        </div>
        <span class="absolute -left-4 -top-4 text-5xl motion-safe:animate-bounce" style="animation-duration: 3s;">🎈</span>
        <span class="absolute -bottom-6 -right-2 text-6xl motion-safe:animate-bounce" style="animation-duration: 4s;">🌴</span>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <StatsCounters stats={stats} />
  </section>

  <PhotoGalleryStrip
    title="Galerie"
    titleAccent="der Seite"
    images={featured.map((i) => ({ src: i.data.heroImage, alt: i.data.name }))}
  />

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="relative mx-auto max-w-sm lg:mx-0">
        <div class="overflow-hidden rounded-3xl">
          <img
            src="/img/isla-turquesa-lanchas-san-blas.webp"
            alt="Leben der Guna-Gemeinde auf San Blas"
            class="h-80 w-full object-cover sm:h-96"
          />
        </div>
        <div class="absolute -right-6 -top-6 h-28 w-28 overflow-hidden rounded-full border-4 border-white shadow-lg sm:h-32 sm:w-32">
          <img src="/img/barco-hundido-snorkel-san-blas.webp" alt="Schnorcheln auf San Blas" class="h-full w-full object-cover" />
        </div>
        <div class="absolute -bottom-8 -right-8 h-36 w-36 overflow-hidden rounded-full border-4 border-white shadow-lg sm:h-40 sm:w-40">
          <img src="/img/palmeras-playa-virgen-san-blas.webp" alt="Strand der Chichime-Insel" class="h-full w-full object-cover" />
        </div>
      </div>

      <div>
        <h2 class="font-display text-3xl font-semibold text-deep sm:text-4xl">
          Warum wir San Blas <span class="text-amber">immer</span> empfehlen
        </h2>
        <p class="mt-4 text-deep/70">
          Die meisten San-Blas-Seiten sind entweder reine Werbebroschüre oder ein einzelner
          Kontakt-Button ohne Inhalt. Wir haben die gebaut, die beides ist: ausführliche und
          ehrliche Guides zu jeder Insel und jeder Tour, dahinter ein Mensch auf WhatsApp, der
          wirklich antwortet.
        </p>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl border border-deep/10 p-5">
            <svg class="h-8 w-8 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4zm6 0a4 4 0 10-4-4" /></svg>
            <h3 class="mt-3 font-heading font-bold text-deep">100 % von der Guna-Gemeinde</h3>
            <p class="mt-1 text-sm text-deep/70">Jede Tour wird von der Guna-Gemeinde des Gebiets geführt, das du besuchst — nicht von einem Veranstalter von außerhalb.</p>
          </div>
          <div class="rounded-2xl border border-deep/10 p-5">
            <svg class="h-8 w-8 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
            <h3 class="mt-3 font-heading font-bold text-deep">Ein Mensch, kein Formular</h3>
            <p class="mt-1 text-sm text-deep/70">Schreib auf WhatsApp und bekomm am selben Tag echte Antworten zu Terminen, Gruppengröße und maßgeschneiderten Paketen.</p>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-6">
          <BookingCta label={t('cta.book')} class="!bg-lime !shadow-lime/30 hover:!bg-limedark" />
          <p class="text-sm text-deep/60">
            <span class="font-display text-2xl font-semibold text-deep">{totalIslas}</span><br />
            Inseln im Detail beschrieben
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="overflow-hidden bg-deep py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
        <div>
          <p class="font-display text-2xl text-amber">Am meisten besucht</p>
          <p class="font-display text-4xl font-semibold text-white sm:text-5xl">Top-Inseln</p>
          <p class="mt-4 max-w-md text-sand/70">
            Guna Yala umfasst mehr als 30 Inseln und Cayos mit eigenem Namen — das hier sind die,
            nach denen am häufigsten gefragt wird, jede mit ihrem eigenen ausführlichen Guide.
          </p>
          <a href="/de/islands" class="mt-6 inline-block rounded-full bg-lime px-6 py-3 font-heading font-bold text-white shadow-lg shadow-lime/30 transition hover:bg-limedark">
            Alle Inseln ansehen
          </a>
        </div>
      </div>

      <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
        {featured.map((island) => {
          const slug = island.id.replace(/^de\//, '');
          return (
            <a href={`/de/islands/${slug}`} class="group overflow-hidden rounded-2xl">
              <div class="h-40 overflow-hidden sm:h-48">
                <img src={island.data.heroImage} alt={island.data.name} loading="lazy" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" />
              </div>
              <p class="mt-2 font-heading font-bold text-white">{island.data.name}</p>
              {island.data.sector && <p class="text-xs text-sand/60">{island.data.sector}</p>}
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between">
      <h2 class="font-heading text-3xl font-extrabold text-deep">Beliebte Tagestouren</h2>
      <a href="/de/tours" class="font-medium text-teal hover:underline">Alle Touren ansehen →</a>
    </div>
    <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {dayTours.map((tour) => {
        const slug = tour.id.replace(/^de\//, '');
        return (
          <TourAmenityCard
            href={`/de/tours/${slug}`}
            heroImage={tour.data.heroImage}
            name={tour.data.name}
            tagline={tour.data.tagline}
            duration={tour.data.duration}
            amenities={tour.data.bestFor.slice(0, 4).map((tg) => tg.replace(/-/g, ' '))}
            whatsappMessage={`Hallo! Ich interessiere mich für ${tour.data.name}.`}
            ctaLabel="Details ansehen"
            whatsappLabel="Nach dem Preis fragen"
          />
        );
      })}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-14 sm:px-6 lg:px-8">
    <a href="/de/yachts" class="flex flex-col items-center gap-8 overflow-hidden rounded-3xl bg-gradient-to-br from-deep to-[#04212b] p-8 sm:flex-row sm:p-12">
      <div class="flex-1 text-center sm:text-left">
        <p class="text-sm font-semibold uppercase tracking-wide text-amber">Ultra-Premium &middot; Vollständig privat</p>
        <h2 class="mt-2 font-display text-3xl font-semibold text-white sm:text-4xl">Private Yacht- und Luxus-Segelcharter</h2>
        <p class="mx-auto mt-3 max-w-lg text-sand/70 sm:mx-0">
          Für Reisende, die San Blas ganz nach ihren Vorstellungen wollen — eine vollständig
          bemannte private Yacht, die eigene Route über mehrere Tage und die exklusivsten Inseln
          des Archipels. Keine geteilten Gruppen, kein fester Zeitplan.
        </p>
        <span class="mt-6 inline-block rounded-full border-2 border-amber px-6 py-3 text-sm font-bold text-amber transition hover:bg-amber hover:text-deep">
          Private Charter entdecken →
        </span>
      </div>
      <div class="h-48 w-full flex-1 overflow-hidden rounded-2xl sm:h-64">
        <img src="/img/catamaran-atardecer-san-blas.webp" alt="Privater Yachtcharter auf San Blas" class="h-full w-full object-cover" />
      </div>
    </a>
  </section>

  <section class="bg-sand py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="font-display text-3xl font-semibold text-deep sm:text-4xl">
          Alles, was du <span class="text-amber">wissen</span> musst
        </h2>
        <p class="mx-auto mt-2 max-w-xl text-deep/60">Praktische Informationen für die Reise, direkt aus den Notizen des Tourveranstalters.</p>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-5 sm:grid-cols-4">
        {infoGuides.map((guide) => (
          <a href={`/de/guides/${guide.id.replace(/^de\//, '')}`} class="group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-deep/5 transition hover:shadow-lg">
            {guide.data.heroImage && (
              <div class="h-28 overflow-hidden">
                <img src={guide.data.heroImage} alt={guide.data.title} loading="lazy" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" />
              </div>
            )}
            <p class="p-3 text-center text-sm font-bold text-deep group-hover:text-lime">{guide.data.title}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Panoramabanner. ⚠️ Sigue sin haber un video real de San Blas para este
       boton: manda a WhatsApp a pedirlo, que es honesto, pero conviene cambiarlo
       por un enlace real cuando exista. La franja de cifras usa los mismos
       numeros reales de arriba, ninguno inventado. -->
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-[2rem]">
      <img
        src="/img/isla-turquesa-lanchas-san-blas.webp"
        alt="San Blas von oben"
        class="h-72 w-full object-cover sm:h-96"
      />
      <div class="absolute inset-0 flex items-center justify-center bg-deep/20">
        <a
          href="https://wa.me/50764684720?text=Hallo!%20Ich%20w%C3%BCrde%20gern%20ein%20Video%20von%20San%20Blas%20sehen."
          target="_blank"
          rel="noopener"
          aria-label="Videomaterial per WhatsApp anfragen"
          class="flex h-16 w-16 items-center justify-center rounded-full border-2 border-white text-white transition hover:bg-white hover:text-deep"
        >
          <svg class="ml-1 h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
        </a>
      </div>
      <div class="absolute inset-x-0 bottom-0 grid grid-cols-2 gap-4 bg-deep/70 px-6 py-5 backdrop-blur-sm sm:grid-cols-4">
        {stats.map((stat) => (
          <div class="text-center sm:text-left">
            <p class="font-display text-2xl font-semibold text-white sm:text-3xl">{stat.value}</p>
            <p class="text-xs text-sand/70 sm:text-sm">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FaqTeaser
    title="Antworten auf"
    titleAccent="deine Fragen"
    description="Direkte Antworten, aus den Notizen des Tourveranstalters selbst."
    quote="Gib uns die Chance, deine Reise zu planen!"
    image="/img/barco-hundido-snorkel-san-blas.webp"
    items={faqItems}
    viewAllHref="/de/faq"
    viewAllLabel="Alle Fragen ansehen"
  />

  <section class="bg-sand py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl font-semibold text-deep sm:text-4xl">Spar dir das <span class="text-amber">Formular</span></h2>
      <p class="mx-auto mt-4 max-w-xl text-deep/70">
        Nenn uns deine Daten, die Gruppengröße und was du suchst — auch ein komplett
        maßgeschneidertes Paket — und bekomm am selben Tag eine echte Antwort von einem Menschen
        auf WhatsApp.
      </p>
      <BookingCta label={t('cta.checkAvailability')} class="mt-8 !bg-lime !shadow-lime/30 hover:!bg-limedark" />
    </div>
  </section>
</Layout>
