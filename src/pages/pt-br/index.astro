---
/*
 * La portada portuguesa, portada de la inglesa el 03/09/2026.
 *
 * Tenia 88 lineas y 2 encabezados `<h2>` contra las 385 y 7 de la inglesa, y no
 * emitia `FAQPage`. El resto del sitio en portugues ya estaba a la par —islas,
 * tours, guias, paquetes, blog—: la portada era lo unico que se quedo de
 * muestra, y encima decia «11 ilhas» cuando son 12.
 *
 * Mismas secciones que la inglesa y la espanola, con el texto escrito a mano.
 * ⚠️ Nada de DeepL: en una web hermana tradujo «San Blas» como «São Blas» y
 * estuvo asi en produccion. «San Blas» no se traduce, ni «Guna Yala», ni los
 * nombres de isla.
 */
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BookingCta from '../../components/BookingCta.astro';
import StatsCounters from '../../components/StatsCounters.astro';
import TourAmenityCard from '../../components/TourAmenityCard.astro';
import FaqTeaser from '../../components/FaqTeaser.astro';
import PhotoGalleryStrip from '../../components/PhotoGalleryStrip.astro';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('pt-br');
const allIslands = await getCollection('islands');
const featured = allIslands.filter((entry) => entry.id.startsWith('pt-br/')).slice(0, 5);

const allTours = await getCollection('tours');
const dayTours = allTours
  .filter((entry) => entry.id.startsWith('pt-br/') && entry.data.category === 'day-tour')
  .slice(0, 3);

const allGuides = await getCollection('guides');
const guideSlugs = ['how-to-get-to-san-blas', 'what-to-pack', 'best-time-to-visit', 'guna-culture', 'snorkeling-diving', 'overnight-stays', 'health-safety-vaccinations', 'top-beaches'];
const infoGuides = guideSlugs
  .map((slug) => allGuides.find((g) => g.id === `pt-br/${slug}.md`))
  .filter((g): g is NonNullable<typeof g> => Boolean(g));

// El numero de islas sale del catalogo, no de la memoria de nadie: esta portada
// llego a decir «11 ilhas» cuando son 12, y el titulo del indice prometia
// «Guia de mais de 30 Ilhas». Una cifra escrita a mano se desfasa sola.
const totalIslas = allIslands.filter((e) => e.id.startsWith('pt-br/')).length;

const stats = [
  { value: '10+', label: 'Passeios reais e pacotes sob medida' },
  { value: String(totalIslas), label: 'Ilhas descritas em detalhe' },
  { value: '5', label: 'Idiomas neste site' },
  { value: '100%', label: 'Passeios conduzidos pela comunidade Guna' },
];

const faqItems = [
  {
    q: 'Como faço para reservar de verdade?',
    a: 'Fale com a gente no WhatsApp — diga suas datas e o tamanho do grupo, e uma pessoa real resolve disponibilidade, pagamento e a busca no hotel direto com você. Sem formulário, sem esperar e-mail.',
  },
  {
    q: 'O que é a taxa de entrada de Guna Yala?',
    a: 'Guna Yala cobra a sua própria taxa de entrada: 22 dólares por estrangeiro e 7 por residente, em dinheiro no posto de controle da comarca. Não está em nenhum preço de passeio, porque não é nossa: é da comunidade.',
  },
  {
    q: 'Preciso de passaporte para entrar em Guna Yala?',
    a: 'Sim. Guna Yala é um território autônomo com o seu próprio controle de entrada e registra quem entra: passaporte para estrangeiros, cédula para residentes. Cópias digitais não são aceitas.',
  },
  {
    q: 'Passeio de um dia ou dormir na ilha — qual escolher?',
    a: 'Os dois incluem pular de ilha em ilha e snorkel no recife do navio afundado. Dormir na ilha acrescenta o pôr do sol, um céu noturno de verdade escuro e um jantar Guna tradicional — e as horas em que já não chega nenhuma lancha.',
  },
];

// As quatro perguntas acima aparecem na página, e é por isso que são declaradas.
// Marcar como FAQPage algo que o visitante não vê é justamente o que penaliza.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title="Passeios a San Blas saindo da Cidade do Panamá"
  description="As ilhas de San Blas explicadas em detalhe, cultura Guna real e reserva pelo WhatsApp com uma pessoa real — sem formulário, sem espera."
  path="/"
  jsonld={faqJsonLd}
>
  <section class="relative overflow-hidden bg-sand">
    <div class="mx-auto grid max-w-7xl items-center gap-8 px-4 py-14 sm:px-6 lg:grid-cols-2 lg:gap-4 lg:px-8 lg:py-20">
      <div class="relative z-10 text-center lg:text-left">
        <p class="font-script text-3xl text-teal">É hora</p>
        <h1 class="mt-1 font-display text-4xl font-semibold leading-[1.1] text-deep sm:text-5xl lg:text-6xl">
          De descobrir o <span class="text-amber">paraíso</span> de Guna Yala
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-lg text-deep/70 lg:mx-0">
          O guia em português mais completo das ilhas de San Blas — fale com a gente no WhatsApp e
          uma pessoa real planeja a viagem com você, sem formulário de contato.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-6 lg:justify-start">
          <BookingCta label={t('cta.book')} class="!bg-lime !shadow-lime/30 hover:!bg-limedark" />
          <a
            href="https://wa.me/50764684720"
            target="_blank"
            rel="noopener"
            class="flex items-center gap-2 text-left"
          >
            <svg class="h-8 w-8 text-teal" fill="currentColor" viewBox="0 0 24 24"><path d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.77.46 3.5 1.34 5.02L2 22l5.13-1.35A9.96 9.96 0 0012.04 22c5.52 0 10-4.48 10-10s-4.48-10-10-10zm0 18.15a8.1 8.1 0 01-4.14-1.13l-.3-.18-3.05.8.81-2.97-.2-.31a8.13 8.13 0 01-1.25-4.36c0-4.49 3.65-8.14 8.14-8.14 2.17 0 4.21.85 5.75 2.39a8.08 8.08 0 012.38 5.75c0 4.49-3.66 8.15-8.14 8.15z"/></svg>
            <span>
              <span class="block font-heading text-sm font-bold text-deep">Saiba mais</span>
              <span class="block font-script text-xl text-amber">Fale com a gente</span>
            </span>
          </a>
        </div>
      </div>

      <div class="relative">
        <div
          class="h-72 overflow-hidden rounded-[2.5rem] sm:h-96 lg:h-[26rem]"
          style="clip-path: polygon(8% 0%, 100% 0%, 100% 92%, 92% 100%, 0% 100%, 0% 8%);"
        >
          <img
            loading="eager"
            fetchpriority="high"
            src="/img/palmera-inclinada-playa-san-blas.webp"
            alt="Ilhas de San Blas, Panamá"
            class="h-full w-full object-cover"
          />
        </div>
        <span class="absolute -left-4 -top-4 text-5xl flotar" style="animation-duration: 6s;">🎈</span>
        <span class="absolute -bottom-6 -right-2 text-6xl flotar" style="animation-duration: 7s;">🌴</span>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <StatsCounters stats={stats} />
  </section>

  <PhotoGalleryStrip
    title="Galeria"
    titleAccent="do site"
    images={featured.map((i) => ({ src: i.data.heroImage, alt: i.data.name }))}
  />

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="relative mx-auto max-w-sm lg:mx-0">
        <div class="overflow-hidden rounded-3xl">
          <img
            loading="lazy"
            src="/img/isla-turquesa-lanchas-san-blas.webp"
            alt="Vida da comunidade Guna em San Blas"
            class="h-80 w-full object-cover sm:h-96"
          />
        </div>
        <div class="absolute -right-6 -top-6 h-28 w-28 overflow-hidden rounded-full border-4 border-white shadow-lg sm:h-32 sm:w-32">
          <img loading="lazy" src="/img/barco-hundido-snorkel-san-blas.webp" alt="Snorkel em San Blas" class="h-full w-full object-cover" />
        </div>
        <div class="absolute -bottom-8 -right-8 h-36 w-36 overflow-hidden rounded-full border-4 border-white shadow-lg sm:h-40 sm:w-40">
          <img loading="lazy" src="/img/palmeras-playa-virgen-san-blas.webp" alt="Praia da Ilha Chichime" class="h-full w-full object-cover" />
        </div>
      </div>

      <div>
        <h2 class="font-display text-3xl font-semibold text-deep sm:text-4xl">
          Por que recomendamos San Blas <span class="text-amber">sempre</span>
        </h2>
        <p class="mt-4 text-deep/70">
          A maioria dos sites sobre San Blas é folheto de propaganda pura ou um único botão de
          contato sem conteúdo nenhum. Construímos o que é as duas coisas: guias profundos e
          honestos de cada ilha e cada passeio, com uma pessoa real no WhatsApp atrás, que responde
          de verdade.
        </p>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl border border-deep/10 p-5">
            <svg class="h-8 w-8 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4zm6 0a4 4 0 10-4-4" /></svg>
            <h3 class="mt-3 font-heading font-bold text-deep">100 % conduzido pela comunidade Guna</h3>
            <p class="mt-1 text-sm text-deep/70">Cada passeio é guiado pela comunidade Guna do território que você visita, não por um operador de fora.</p>
          </div>
          <div class="rounded-2xl border border-deep/10 p-5">
            <svg class="h-8 w-8 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
            <h3 class="mt-3 font-heading font-bold text-deep">Uma pessoa, não um formulário</h3>
            <p class="mt-1 text-sm text-deep/70">Escreva no WhatsApp e receba no mesmo dia respostas reais sobre datas, grupo e pacotes sob medida.</p>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-6">
          <BookingCta label={t('cta.book')} class="!bg-lime !shadow-lime/30 hover:!bg-limedark" />
          <p class="text-sm text-deep/60">
            <span class="font-display text-2xl font-semibold text-deep">{totalIslas}</span><br />
            ilhas descritas em detalhe
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="overflow-hidden bg-deep py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
        <div>
          <p class="font-display text-2xl text-amber">As mais visitadas</p>
          <p class="font-display text-4xl font-semibold text-white sm:text-5xl">Ilhas em destaque</p>
          <p class="mt-4 max-w-md text-sand/70">
            Guna Yala tem mais de 30 ilhas e cayos com nome próprio — estas são as que mais nos
            perguntam, cada uma com o seu guia completo.
          </p>
          <a href="/pt-br/islands" class="mt-6 inline-block rounded-full bg-lime px-6 py-3 font-heading font-bold text-white shadow-lg shadow-lime/30 transition hover:bg-limedark">
            Ver todas as ilhas
          </a>
        </div>
      </div>

      <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
        {featured.map((island) => {
          const slug = island.id.replace(/^pt-br\//, '');
          return (
            <a href={`/pt-br/islands/${slug}`} class="group overflow-hidden rounded-2xl">
              <div class="h-40 overflow-hidden sm:h-48">
                <img src={island.data.heroImage} alt={island.data.name} loading="lazy" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" />
              </div>
              <p class="mt-2 font-heading font-bold text-white">{island.data.name}</p>
              {island.data.sector && <p class="text-xs text-sand/60">{island.data.sector}</p>}
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between">
      <h2 class="font-heading text-3xl font-extrabold text-deep">Passeios de um dia populares</h2>
      <a href="/pt-br/tours" class="font-medium text-teal hover:underline">Ver todos os passeios →</a>
    </div>
    <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {dayTours.map((tour) => {
        const slug = tour.id.replace(/^pt-br\//, '');
        return (
          <TourAmenityCard
            href={`/pt-br/tours/${slug}`}
            heroImage={tour.data.heroImage}
            name={tour.data.name}
            tagline={tour.data.tagline}
            duration={tour.data.duration}
            amenities={tour.data.bestFor.slice(0, 4).map((tg) => tg.replace(/-/g, ' '))}
            whatsappMessage={`Oi! Tenho interesse no ${tour.data.name}.`}
            ctaLabel="Ver detalhes"
            whatsappLabel="Perguntar o preço"
          />
        );
      })}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-14 sm:px-6 lg:px-8">
    <a href="/pt-br/yachts" class="flex flex-col items-center gap-8 overflow-hidden rounded-3xl bg-gradient-to-br from-deep to-[#04212b] p-8 sm:flex-row sm:p-12">
      <div class="flex-1 text-center sm:text-left">
        <p class="text-sm font-semibold uppercase tracking-wide text-amber">Ultra-premium &middot; Totalmente privativo</p>
        <h2 class="mt-2 font-display text-3xl font-semibold text-white sm:text-4xl">Charters privativos de iate e vela de luxo</h2>
        <p class="mx-auto mt-3 max-w-lg text-sand/70 sm:mx-0">
          Para quem quer San Blas completamente do seu jeito — um iate privativo com tripulação
          completa, o seu próprio roteiro de vários dias e as ilhas mais exclusivas do arquipélago.
          Sem grupos compartilhados, sem horário fixo.
        </p>
        <span class="mt-6 inline-block rounded-full border-2 border-amber px-6 py-3 text-sm font-bold text-amber transition hover:bg-amber hover:text-deep">
          Conhecer os charters privativos →
        </span>
      </div>
      <div class="h-48 w-full flex-1 overflow-hidden rounded-2xl sm:h-64">
        <img loading="lazy" src="/img/catamaran-atardecer-san-blas.webp" alt="Charter privativo de iate em San Blas" class="h-full w-full object-cover" />
      </div>
    </a>
  </section>

  <section class="bg-sand py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="font-display text-3xl font-semibold text-deep sm:text-4xl">
          Tudo o que você precisa <span class="text-amber">saber</span>
        </h2>
        <p class="mx-auto mt-2 max-w-xl text-deep/60">Informação prática para a viagem, direto das anotações de quem opera o passeio.</p>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-5 sm:grid-cols-4">
        {infoGuides.map((guide) => (
          <a href={`/pt-br/guides/${guide.id.replace(/^pt-br\//, '')}`} class="group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-deep/5 transition hover:shadow-lg">
            {guide.data.heroImage && (
              <div class="h-28 overflow-hidden">
                <img src={guide.data.heroImage} alt={guide.data.title} loading="lazy" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" />
              </div>
            )}
            <p class="p-3 text-center text-sm font-bold text-deep group-hover:text-lime">{guide.data.title}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Faixa panorâmica. ⚠️ Ainda não existe um vídeo real de San Blas para este
       botão: ele manda para o WhatsApp pedir um, o que é honesto, mas convém
       trocar por um link real quando existir. A faixa de números usa os mesmos
       valores reais de cima, nenhum inventado. -->
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-[2rem]">
      <img
        loading="lazy"
        src="/img/isla-turquesa-lanchas-san-blas.webp"
        alt="San Blas visto de cima"
        class="h-72 w-full object-cover sm:h-96"
      />
      <div class="absolute inset-0 flex items-center justify-center bg-deep/20">
        <a
          href="https://wa.me/50764684720?text=Oi!%20Eu%20gostaria%20de%20ver%20um%20v%C3%ADdeo%20de%20San%20Blas."
          target="_blank"
          rel="noopener"
          aria-label="Pedir um vídeo pelo WhatsApp"
          class="flex h-16 w-16 items-center justify-center rounded-full border-2 border-white text-white transition hover:bg-white hover:text-deep"
        >
          <svg class="ml-1 h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
        </a>
      </div>
      <div class="absolute inset-x-0 bottom-0 grid grid-cols-2 gap-4 bg-deep/70 px-6 py-5 backdrop-blur-sm sm:grid-cols-4">
        {stats.map((stat) => (
          <div class="text-center sm:text-left">
            <p class="font-display text-2xl font-semibold text-white sm:text-3xl">{stat.value}</p>
            <p class="text-xs text-sand/70 sm:text-sm">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FaqTeaser
    title="Respostas para"
    titleAccent="as suas dúvidas"
    description="Respostas diretas, tiradas das anotações de quem opera o passeio."
    quote="Deixa a gente ajudar a planejar a sua viagem!"
    image="/img/barco-hundido-snorkel-san-blas.webp"
    items={faqItems}
    viewAllHref="/pt-br/faq"
    viewAllLabel="Ver todas as perguntas"
  />

  <section class="bg-sand py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl font-semibold text-deep sm:text-4xl">Pule o <span class="text-amber">formulário</span></h2>
      <p class="mx-auto mt-4 max-w-xl text-deep/70">
        Diga as suas datas, o tamanho do grupo e o que você procura — até um pacote totalmente sob
        medida — e receba no mesmo dia uma resposta real de uma pessoa real no WhatsApp.
      </p>
      <BookingCta label={t('cta.checkAvailability')} class="mt-8 !bg-lime !shadow-lime/30 hover:!bg-limedark" />
    </div>
  </section>
</Layout>
