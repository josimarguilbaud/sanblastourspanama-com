---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import BookingCta from '../../../components/BookingCta.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import RelatedCards from '../../../components/RelatedCards.astro';
import EnlaceHermana from '../../../components/EnlaceHermana.astro';
import WidgetReserva from '../../../components/WidgetReserva.astro';
import { localesForSlug } from '../../../i18n/content';
import { useTranslations } from '../../../i18n/ui';
import { unicaReservable } from '../../../lib/reservas';
import { faqJsonLd } from '../../../lib/faq';
import { Image } from 'astro:assets';
import { resolverImagen } from '../../../lib/images';

export async function getStaticPaths() {
  const allIslands = await getCollection('islands');
  return allIslands
    .filter((entry) => entry.id.startsWith('pt-br/'))
    .map((entry) => ({
      params: { slug: entry.id.replace(/^pt-br\//, '') },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name, sector, heroImage, bestFor, isInhabited, relatedTourKeys, seoTitle, seoDescription } = entry.data;
const slug = entry.id.replace(/^pt-br\//, '');
const t = useTranslations('pt-br');

const allIslands = await getCollection('islands');
const availableLocales = localesForSlug(allIslands, slug);
const claveReservable = unicaReservable(relatedTourKeys);

/* Paridad con en/es: esta plantilla no traía "Tours That Visit This Island"
 * todavía (no era un faltante deliberado, solo no se había hecho). */
const allTours = await getCollection('tours');
const relatedTours = allTours
  .filter((tr) => tr.id.startsWith('pt-br/') && relatedTourKeys.includes(tr.data.tourKey ?? ''))
  .map((tr) => ({
    href: `/pt-br/tours/${tr.id.replace(/^pt-br\//, '')}`,
    heroImage: tr.data.heroImage,
    title: tr.data.name,
    subtitle: tr.data.category === 'day-tour' ? 'Passeio de Um Dia' : 'Estadia Noturna',
  }));
// El FAQPage sale del propio Markdown: las preguntas se escriben en el cuerpo
// y por tanto se VEN en la pagina, que es lo que Google exige para marcarlas.
// Ver src/lib/faq.ts. Devuelve null si la entrada aun no tiene seccion.
const faqLd = faqJsonLd(entry.body ?? '');
---

<Layout
  title={seoTitle ?? `${name} — Ilhas de San Blas`}
  description={seoDescription ?? name}
  image={heroImage}
  path={`/islands/${slug}`}
  availableLocales={availableLocales}
>
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}

  <div class="h-[45vh] min-h-[320px] w-full overflow-hidden">
    <Image src={resolverImagen(heroImage)} densities={[1, 2]} alt={name} loading="eager" fetchpriority="high" class="h-full w-full object-cover" />
  </div>

  <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'Ilhas', href: '/islands' }, { label: name }]} />

  <div class:list={["mx-auto max-w-6xl px-4 pb-12 pt-4 sm:px-6 lg:px-8", claveReservable && "lg:grid lg:grid-cols-[1fr_380px] lg:items-start lg:gap-10"]}>
    <article class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wide text-teal">
        {sector} {isInhabited ? '· Comunidade Guna' : '· Ilha desabitada'}
      </p>
      <h1 class="mt-2 font-display text-4xl font-semibold text-deep sm:text-5xl">{name}</h1>

      <div class="mt-4 flex flex-wrap gap-2">
        {bestFor.map((tag: string) => (
          <span class="rounded-full bg-lime/10 px-3 py-1 text-sm font-medium text-limedark">
            {tag.replace(/-/g, ' ')}
          </span>
        ))}
      </div>

      <div class="prose prose-headings:font-heading prose-headings:text-deep prose-a:text-teal mt-8 max-w-none">
        <Content />
        <EnlaceHermana tipo="island" slug={slug} lang="pt-br" />
      </div>

      <div class="mt-12 rounded-3xl bg-deep p-8 text-center">
        <p class="font-heading text-xl font-bold text-white">Pronto para conhecer {name}?</p>
        <BookingCta label={t('cta.checkAvailability')} class="mt-5 !bg-lime !shadow-lime/30 hover:!bg-limedark" />
      </div>
    </article>

    {claveReservable && (
      <aside class="mt-10 lg:sticky lg:top-28 lg:mt-0">
        <WidgetReserva tourKey={claveReservable} lang="pt-br" titulo={t('widget.bookOnline')} nota={t('widget.bookOnlineNota')} compact />
      </aside>
    )}
  </div>

  <RelatedCards title="Passeios Que Visitam Esta Ilha" items={relatedTours} />
</Layout>
