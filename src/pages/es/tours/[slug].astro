---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import BookingCta from '../../../components/BookingCta.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import RelatedCards from '../../../components/RelatedCards.astro';
import WidgetReserva from '../../../components/WidgetReserva.astro';
import { localesForSlug } from '../../../i18n/content';
import { useTranslations } from '../../../i18n/ui';
import { faqJsonLd } from '../../../lib/faq';

export async function getStaticPaths() {
  const allTours = await getCollection('tours');
  return allTours
    .filter((entry) => entry.id.startsWith('es/'))
    .map((entry) => ({
      params: { slug: entry.id.replace(/^es\//, '') },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name, category, tourKey, tagline, heroImage, duration, bestFor, relatedIslandSlugs, seoTitle, seoDescription } = entry.data;
const slug = entry.id.replace(/^es\//, '');
const t = useTranslations('es');

const allTours = await getCollection('tours');
const availableLocales = localesForSlug(allTours, slug);

const allIslands = await getCollection('islands');
const relatedIslands = allIslands
  .filter((i) => i.id.startsWith('es/') && relatedIslandSlugs.includes(i.id.replace(/^es\//, '')))
  .map((i) => ({
    href: `/es/islands/${i.id.replace(/^es\//, '')}`,
    heroImage: i.data.heroImage,
    title: i.data.name,
    subtitle: i.data.sector,
  }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name,
  description: seoDescription ?? tagline,
  image: heroImage,
  touristType: bestFor,
  provider: { '@type': 'TravelAgency', name: 'San Blas Tours Panamá' },
};
// El FAQPage sale del propio Markdown: las preguntas se escriben en el cuerpo
// y por tanto se VEN en la pagina, que es lo que Google exige para marcarlas.
// Ver src/lib/faq.ts. Devuelve null si la entrada aun no tiene seccion.
const faqLd = faqJsonLd(entry.body ?? '');
---

<Layout
  title={seoTitle ?? `${name} — Tours de San Blas`}
  description={seoDescription ?? tagline}
  image={heroImage}
  path={`/tours/${slug}`}
  availableLocales={availableLocales}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}

  <div class="h-[45vh] min-h-[320px] w-full overflow-hidden">
    {/* El hero es la foto DE ESTA ficha. Antes las 105 paginas de tour y
        paquete servian todas la misma foto generica mientras el og:image si
        usaba la suya: el visitante veia una foto y al compartir salia otra.
        La generica queda solo de respaldo (heroImage es obligatoria en el
        esquema, asi que hoy no llega a usarse). */}
    <img src={heroImage ?? '/img/palmera-inclinada-playa-san-blas.webp'} alt={name} loading="eager" fetchpriority="high" class="h-full w-full object-cover" />
  </div>

  <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Tours', href: '/tours' }, { label: name }]} />

  <article class="mx-auto max-w-3xl px-4 pb-12 pt-4 sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-wide text-teal">
      {category === 'day-tour' ? 'Pasadía' : 'Estadía Nocturna'} · {duration}
    </p>
    <h1 class="mt-2 font-display text-4xl font-semibold text-deep sm:text-5xl">{name}</h1>
    <p class="mt-3 text-lg text-deep/70">{tagline}</p>

    <div class="mt-4 flex flex-wrap gap-2">
      {bestFor.map((tag: string) => (
        <span class="rounded-full bg-lime/10 px-3 py-1 text-sm font-medium text-limedark">
          {tag.replace(/-/g, ' ')}
        </span>
      ))}
    </div>

    <div class="prose prose-headings:font-heading prose-headings:text-deep prose-a:text-teal mt-8 max-w-none">
      <Content />
      <WidgetReserva
        tourKey={tourKey}
        category={category}
        lang="es"
        titulo="Reserva este tour en línea"
        nota={category === 'overnight' ? "Elige tus fechas y paga el abono con tarjeta. El tipo de cabaña se elige dentro del formulario." : "Elige tu fecha, mira disponibilidad y paga el abono con tarjeta. ¿Prefieres hablarlo? El WhatsApp está justo arriba."}
      />
    </div>

    <div class="mt-12 rounded-3xl bg-deep p-8 text-center">
      <p class="font-heading text-xl font-bold text-white">¿Te interesa {name}?</p>
      <p class="mt-2 text-sand/70">Escríbenos por WhatsApp — una persona real confirma fechas, tamaño de grupo y precio directamente contigo.</p>
      <BookingCta label={t('cta.book')} message={`¡Hola! Me interesa el ${name}.`} class="mt-5 !bg-lime !shadow-lime/30 hover:!bg-limedark" />
    </div>
  </article>

  <RelatedCards title="Islas en Este Tour" items={relatedIslands} />
</Layout>
