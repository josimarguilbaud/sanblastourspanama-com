---
/**
 * Las veinte opiniones reales de viajeros.
 *
 * Hasta el 03/09/2026 esta web no tenía NINGUNA prueba social: ni una reseña,
 * ni agregado, ni una cita con nombre — siendo la de más tráfico orgánico de
 * las tres del negocio. Las veinte se mudaron desde las webs hermanas, no se
 * copiaron: el mismo texto en dos dominios del mismo dueño es duplicación.
 * Ver `src/lib/reviews.ts`.
 */
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Reviews from '../../components/Reviews.astro';
import BookingCta from '../../components/BookingCta.astro';
import { AGGREGATE, reviewsJsonLd } from '../../lib/reviews';

const LANG = "es";
const SITIO = 'https://sanblastourspanama.com';

/* Las reseñas van dentro del TravelAgency, y el agregado con ellas: esta
 * página SÍ las muestra, que es lo que Google exige para aceptarlo. */
const resenas = reviewsJsonLd(LANG, SITIO);
const agregado = { '@type': 'AggregateRating', ...AGGREGATE };

const migas = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: "Inicio", item: `${SITIO}/es` },
    { '@type': 'ListItem', position: 2, name: "Opiniones", item: `${SITIO}/es/reviews` },
  ],
};
---

<Layout
  title="Opiniones de San Blas — Lo que dicen los viajeros"
  description="Veinte opiniones de viajeros que ya estuvieron en San Blas: la cultura Guna, el agua, las islas y lo que más les sorprendió. Reales, sin retocar."
  path="/reviews"
  jsonld={migas}
  reviews={resenas}
  aggregateRating={agregado}
>
  <section class="bg-teal/5 py-14">
    <div class="mx-auto max-w-6xl px-4">
      <Breadcrumbs items={[{ label: "Inicio", href: "/es" }, { label: "Opiniones" }]} />
      <h1 class="mt-4 text-3xl font-bold text-deep sm:text-4xl">Lo que dicen los viajeros que ya fueron</h1>
      <p class="mt-4 max-w-3xl text-lg text-deep/75">Veinte opiniones de gente que ya hizo el viaje. Las publicamos tal como llegaron, sin estrellas: no consta qué puntuación puso cada quien, e inventarse ese número sería lo más fácil de esta página y lo más deshonesto.</p>
    </div>
  </section>

  <Reviews lang={LANG} />

  <section class="bg-white py-14">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="text-2xl font-bold text-deep">¿Listo para verlo tú mismo?</h2>
      <p class="mt-2 text-deep/75">Elige fecha y mira disponibilidad, o escríbenos por WhatsApp si prefieres hablarlo antes.</p>
      <div class="mt-5 flex flex-wrap items-center gap-4">
        <a href="/es/tours" class="rounded-lg bg-coral px-6 py-3 font-semibold text-white no-underline hover:bg-coraldark">Ver tours</a>
        <BookingCta />
      </div>
    </div>
  </section>
</Layout>
